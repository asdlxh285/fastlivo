<launch>
  <!-- =========================
       Global map config
       ========================= -->
  <arg name="pcd_file" default="/home/uav/catkin_ws/src/FreeDOM/generated_pcd/static_map_point.pcd"/>
  <arg name="map_topic" default="/map"/>
  <arg name="map_frame" default="old_map"/>
  <arg name="map_publish_interval" default="1.0"/>

  <!-- =========================
       Online inputs from FAST-LIO
       ========================= -->
  <arg name="scan_topic" default="/cloud_registered"/>
  <arg name="odom_topic" default="/Odometry"/>

  <!-- =========================
       ICP / relocalization params
       ========================= -->
  <arg name="freq_localization" default="0.5"/>
  <arg name="localization_th" default="0.79"/>
  <arg name="max_init_yaw_err_deg" default="35.0"/>

  <arg name="local_map_frames" default="3"/>
  <arg name="fov" default="6.28"/>
  <arg name="fov_far" default="40.0"/>

  <arg name="min_scan_points" default="80"/>
  <arg name="min_submap_points" default="120"/>

  <arg name="global_fallback" default="true"/>

  <!-- voxel size -->
  <arg name="map_voxel_size" default="0.2"/>
  <arg name="scan_voxel_size" default="0.1"/>

  <!-- =========================
       TF frame config
       ========================= -->
  <!-- ICP map frame建议先与地图frame保持一致，便于调试 -->
  <arg name="icp_map_frame" default="$(arg map_frame)"/>

  <!-- FAST-LIO odom frame -->
  <arg name="odom_frame" default="camera_init"/>

  <!-- robot body frame -->
  <arg name="base_frame" default="body"/>

  <!-- publish old_map -> camera_init -->
  <arg name="publish_icp_tf" default="true"/>

  <!-- 不发布 old_map -> body，避免和原系统 body TF 冲突 -->
  <arg name="publish_body_tf" default="false"/>

  <!-- =========================
       Publish pcd map as PointCloud2
       ========================= -->
  <node pkg="pcl_ros"
        type="pcd_to_pointcloud"
        name="pcd_map_publisher"
        output="screen"
        args="$(arg pcd_file) $(arg map_publish_interval)">
    <param name="frame_id" value="$(arg map_frame)"/>
    <remap from="cloud_pcd" to="$(arg map_topic)"/>
  </node>

  <!-- =========================
       ICP relocalization node
       ========================= -->
  <node pkg="my_drone"
        type="icp.py"
        name="fast_lio_localization"
        output="screen">

    <!-- topics -->
    <param name="map_topic" value="$(arg map_topic)"/>
    <param name="map_frame" value="$(arg map_frame)"/>
    <param name="scan_topic" value="$(arg scan_topic)"/>
    <param name="odom_topic" value="$(arg odom_topic)"/>

    <!-- thresholds / runtime -->
    <param name="FREQ_LOCALIZATION" value="$(arg freq_localization)"/>
    <param name="LOCALIZATION_TH" value="$(arg localization_th)"/>
    <param name="max_init_yaw_err_deg" value="$(arg max_init_yaw_err_deg)"/>

    <!-- local map / crop -->
    <param name="LOCAL_MAP_FRAMES" value="$(arg local_map_frames)"/>
    <param name="fov" value="$(arg fov)"/>
    <param name="fov_far" value="$(arg fov_far)"/>
    <param name="min_scan_points" value="$(arg min_scan_points)"/>
    <param name="min_submap_points" value="$(arg min_submap_points)"/>
    <param name="global_fallback" value="$(arg global_fallback)"/>

    <!-- voxel -->
    <param name="map_voxel_size" value="$(arg map_voxel_size)"/>
    <param name="scan_voxel_size" value="$(arg scan_voxel_size)"/>

    <!-- tf -->
    <param name="publish_icp_tf" value="$(arg publish_icp_tf)"/>
    <param name="publish_body_tf" value="$(arg publish_body_tf)"/>
    <param name="icp_map_frame" value="$(arg icp_map_frame)"/>
    <param name="odom_frame" value="$(arg odom_frame)"/>
    <param name="base_frame" value="$(arg base_frame)"/>
  </node>
</launch>